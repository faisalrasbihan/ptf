# Required for live market data
TIINGO_KEY=your_tiingo_api_key_here

# Project metadata
PROJECT_NAME=ptf
VERSION=0.1.0
DEBUG=false

# Forecast horizon defaults and bounds, in trading days
DEFAULT_FORECAST_DAYS=30
MIN_FORECAST_DAYS=5
MAX_FORECAST_DAYS=90

# Data and model timeouts
TIINGO_TIMEOUT_SECONDS=15
MODEL_TIMEOUT_SECONDS=60
HISTORY_YEARS=2

# Optional debug chart endpoints
DEBUG_ENDPOINTS_ENABLED=false

# Default model selection
KRONOS_MODEL_ALIAS=kronos-mini
KRONOS_DEVICE=cpu
KRONOS_MAX_CONTEXT=2048
KRONOS_TEMPERATURE=1.0
KRONOS_TOP_P=0.9
KRONOS_SAMPLE_COUNT=1

# Kronos model IDs and aliases
KRONOS_MODEL_ID=NeoQuasar/Kronos-mini
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-2k
KRONOS_MINI_MODEL_ID=NeoQuasar/Kronos-mini
KRONOS_MINI_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-2k
KRONOS_MINI_MODEL_ALIAS=kronos-mini
KRONOS_MINI_MAX_CONTEXT=2048
KRONOS_SMALL_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_SMALL_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_SMALL_MODEL_ALIAS=kronos-small
KRONOS_SMALL_MAX_CONTEXT=512
KRONOS_BASE_MODEL_ID=NeoQuasar/Kronos-base
KRONOS_BASE_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_BASE_MODEL_ALIAS=kronos-base
KRONOS_BASE_MAX_CONTEXT=512

# Chronos model settings
CHRONOS_MODEL_ID=amazon/chronos-2
CHRONOS_MODEL_ALIAS=amazon-chronos-2
CHRONOS_DEVICE_MAP=cpu

# TimesFM model settings
TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch
TIMESFM_MODEL_ALIAS=google-timesfm-2.5
TIMESFM_MAX_CONTEXT=1024
TIMESFM_MAX_HORIZON=256
